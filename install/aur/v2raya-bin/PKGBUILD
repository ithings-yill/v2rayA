# Maintainer: mzz2017 <mzz@tuta.io>

pkgname=v2raya-bin
_pkgname=v2raya
pkgver=The_Real_Version
pkgrel=1
install=.INSTALL
pkgdesc="A web GUI client of Project V which supports VMess, VLESS, SS, SSR, Trojan, Tuic and Juicity protocols"
arch=('i686' 'x86_64' 'armv7h' 'aarch64' 'loong64')
url="https://github.com/ithings-yill/v2rayA"
license=('AGPL3')
provides=('v2raya')
conflicts=('v2raya')
backup=("etc/default/v2raya")

source_i686=(
    "v2raya_${pkgver}::https://github.com/ithings-yill/v2rayA/releases/download/v${pkgver}/v2raya_linux_x86_${pkgver}"
    "v2raya_core_${pkgver}::https://github.com/ithings-yill/v2rayA/releases/download/v${pkgver}/v2raya_core_linux_x86_${pkgver}"
)
source_x86_64=(
    "v2raya_${pkgver}::https://github.com/ithings-yill/v2rayA/releases/download/v${pkgver}/v2raya_linux_x64_${pkgver}"
    "v2raya_core_${pkgver}::https://github.com/ithings-yill/v2rayA/releases/download/v${pkgver}/v2raya_core_linux_x64_${pkgver}"
)
source_aarch64=(
    "v2raya_${pkgver}::https://github.com/ithings-yill/v2rayA/releases/download/v${pkgver}/v2raya_linux_arm64_${pkgver}"
    "v2raya_core_${pkgver}::https://github.com/ithings-yill/v2rayA/releases/download/v${pkgver}/v2raya_core_linux_arm64_${pkgver}"
)
source_armv7h=(
    "v2raya_${pkgver}::https://github.com/ithings-yill/v2rayA/releases/download/v${pkgver}/v2raya_linux_armv7_${pkgver}"
    "v2raya_core_${pkgver}::https://github.com/ithings-yill/v2rayA/releases/download/v${pkgver}/v2raya_core_linux_armv7_${pkgver}"
)
source_loong64=(
    "v2raya_${pkgver}::https://github.com/ithings-yill/v2rayA/releases/download/v${pkgver}/v2raya_linux_loongarch64_${pkgver}"
    "v2raya_core_${pkgver}::https://github.com/ithings-yill/v2rayA/releases/download/v${pkgver}/v2raya_core_linux_loongarch64_${pkgver}"
)

sha256sums_i686=('{{sha256sums_i686}}')
sha256sums_x86_64=('{{sha256sums_x86_64}}')
sha256sums_armv7h=('{{sha256sums_armv7h}}')
sha256sums_aarch64=('{{sha256sums_aarch64}}')
sha256sums_loong64=('{{sha256sums_loong64}}')

package() {
    depends+=('v2ray-domain-list-community' 'v2ray-geoip')

    cp -a "${srcdir}"/etc "${srcdir}"/usr "${pkgdir}"/
    rm -rf "${pkgdir}"/usr/share/v2raya/*
    ln -sf /usr/share/v2ray/geoip.dat "${pkgdir}"/usr/share/v2raya/geoip.dat
    ln -sf /usr/share/v2ray/geosite.dat "${pkgdir}"/usr/share/v2raya/geosite.dat
}
